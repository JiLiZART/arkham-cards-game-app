{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist", "node_modules", "inspired", ".wrangler"],
  "overrides": [
    {
      "files": ["src/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react", "react-dom", "three", "@react-three/*", "zustand"],
                "message": "engine must not depend on UI/rendering"
              },
              {
                "group": ["**/ui/**", "../ui/*", "../../ui/*"],
                "message": "engine must not import UI"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["content/**/scripts/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "g",
            "property": "s",
            "message": "scripts reach the game only through src/engine/api.ts (its accessors for cards, piles, counters, flags and the test)"
          }
        ]
      }
    }
  ]
}
