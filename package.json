    "format:fix": "oxfmt --write",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "import:investigators": "tsx scripts/import-investigators.ts",
    "coverage": "tsx scripts/coverage.ts",
    "import:cards": "tsx scripts/import-cards.ts",
    "import:i18n": "tsx scripts/import-i18n.ts",
    "check:content": "tsx scripts/check-content.ts",
    "import:sounds": "tsx scripts/import-sounds.ts",
    "import:icons": "tsx scripts/import-icons.ts",
    "fetch:cards": "tsx scripts/fetch-card-images.ts",
    "import:ru-cards": "tsx scripts/import-ru-cards.ts",
    "import:campaigns": "tsx scripts/import-campaigns.ts",
    "import:art": "tsx scripts/import-art.ts",
    "sound-credits": "tsx scripts/sound-credits.ts",
